# --- Database --------------------------------------------------------------
# FOUR connection strings, and the difference is the isolation model. Pointing
# the app at the owner role makes every guarantee in this repo silently false
# while every naive test still passes.
#
# 1. The application. presby_app is NOBYPASSRLS, so row-level security is
#    enforced on every tenant table. Pooled endpoint.
DATABASE_URL=postgres://presby_app:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require

# 2. Platform admin pages ONLY — this role bypasses RLS, which is exactly why it
#    is a separate connection and not a flag on the first one.
PLATFORM_DATABASE_URL=postgres://presby_platform:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/dbname?sslmode=require

# 3. DDL and migrations. Owner role on the DIRECT (unpooled) endpoint — Drizzle
#    Kit and psql want a real session, not a pooled one.
MIGRATE_DATABASE_URL=postgres://neondb_owner:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# 4. scripts/test-rls.sql. MUST be presby_app: run the isolation suite as the
#    owner and it proves nothing, because the owner has rolbypassrls = t.
APP_DATABASE_URL=postgres://presby_app:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- NextAuth (v5 / Auth.js) ------------------------------------------------
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public origin of the deployed app. Local dev defaults to http://localhost:3000.
# NextAuth v5 uses AUTH_URL (not the v4 NEXTAUTH_URL). In production, set this
# to your public https URL — it also acts as an independent trustHost signal,
# which is useful for deployers who want to remove the code-level trustHost: true
# from src/lib/auth/config.ts and rely on env-only opt-in instead (DECISION-016).
AUTH_URL=http://localhost:3000

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: env-scoped alternative to the trustHost: true in src/lib/auth/config.ts.
# Redundant when AUTH_URL is set to the production URL or when trustHost: true
# is in code. Never needed on Vercel (VERCEL env auto-enables host trust) or
# Cloudflare Pages (CF_PAGES env). See DECISION-016.
# AUTH_TRUST_HOST=true

# --- First-run admin bootstrap ---------------------------------------------
# Comma-separated list of email addresses that should be granted the `admin`
# role automatically when they first sign in via Google. Single value or many.
# Examples:
#   INITIAL_ADMIN_EMAILS=you@example.com
#   INITIAL_ADMIN_EMAILS=you@example.com,teammate@example.com
INITIAL_ADMIN_EMAILS=you@example.com

# --- Seeded local admin (for credentials-login testing) --------------------
# If both are set, `npm run db:seed` upserts a credentials-login admin user
# with this email + password and binds them to the admin role. twoFactorRequired
# is false on this user so /admin loads in one click — convenient for local
# testing, NOT suitable for production. Leave both empty in any deployed env.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Seeded member user (for e2e member-flow tests) -----------------------
# If both are set, `npm run db:seed` upserts a credentials-login member user
# with this email + password and binds them to the member role. Leave empty
# in any deployed environment.
SEED_MEMBER_EMAIL=
SEED_MEMBER_PASSWORD=

# --- Seeded MFA admin user (for e2e 2FA gate tests) -----------------------
# If both are set, `npm run db:seed` upserts an admin user with
# twoFactorRequired=true and NO TOTP enrollment record. Used by e2e tests to
# assert the /totp redirect fires — not to complete the full TOTP challenge.
# Leave empty in any deployed environment.
SEED_MFA_ADMIN_EMAIL=
SEED_MFA_ADMIN_PASSWORD=

# --- TOTP 2FA --------------------------------------------------------------
# 32-byte base64 key used to AES-256-GCM-encrypt every enrolled TOTP secret
# at rest. Rotating this key invalidates every enrolled 2FA secret in the DB —
# do not rotate casually.
# Generate: openssl rand -base64 32
AUTH_TOTP_ENCRYPTION_KEY=

# --- App URL ---------------------------------------------------------------
# Public URL of the deployed app, used to generate email verification links.
# Must be set in production. Local dev falls back to http://localhost:3000.
# Example: https://myapp.vercel.app
NEXT_PUBLIC_APP_URL=

# --- Email (Resend) --------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="presby <noreply@example.com>"

# Resend webhook signing secret. Obtain from your Resend dashboard → Webhooks.
# When absent, the /api/webhooks/resend handler returns 200 {received:false}
# rather than attempting signature verification — clean no-op for forks that
# have not configured a webhook endpoint.
# RESEND_WEBHOOK_SECRET=

# --- Email queue worker (Vercel cron) --------------------------------------
# REQUIRED in production: the email queue processor returns 503 when this is
# unset, accumulating emails indefinitely without processing.
# Generate: openssl rand -base64 32
CRON_SECRET=

# --- Email dev overrides (dev/test only — NEVER set in production) ---------
# Skip Resend entirely; mark queued rows as 'sent' with a synthetic id.
# Useful for local testing without a Resend API key.
# EMAIL_DEV_INTERCEPT=1

# Override the recipient address; all emails are delivered to this address
# instead. The intended recipient is still stored on the queue row (toEmail).
# EMAIL_DEV_REDIRECT_TO=

# --- Cloudflare Turnstile (optional) ---------------------------------------
# Bot-challenge widget on /signin (credentials form) and /forgot-password.
# Both keys must be set together. Leave blank (the default) to keep
# forms working with no challenge — complete no-op, e2e tests pass unchanged.
# Get keys at https://dash.cloudflare.com/ → Turnstile.
# Use "localhost" as an allowed origin for local dev testing.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Rate limiting (Upstash Redis) — Optional ------------------------------
# When both vars are set the rate limiter upgrades from in-memory (resets on
# cold start, single-instance only) to Upstash Redis (durable, distributed).
# Recommended for any production deployment. https://upstash.com/
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Escape hatch — short-circuits every checkRateLimit() to "allowed". Set this
# in local .env.local and in CI secrets when running e2e tests: both the
# globalSetup sign-in calls and any spec-body sign-ins accumulate rate-limit
# state against the in-memory limiter. A globalSetup retry for the same email
# within the rate-limit window will fail with a credentials error without this.
# NEVER set in production — defeats the whole point.
# RATE_LIMIT_DISABLED=true

# Trust proxy headers for IP extraction in rate limiting.
# When false (the default), only x-real-ip is read (safe on Vercel; cannot be
# spoofed by clients). Set to true ONLY if you deploy behind a proxy you
# control that replaces (not appends) x-forwarded-for. Setting this to true
# on any other deployment allows attackers to spoof their IP identity and bypass
# per-IP rate limits.
# TRUST_PROXY_HEADERS=false

# --- E2E database isolation -------------------------------------------------
# By default, globalSetup warns locally and hard-blocks in CI if DATABASE_URL
# points at a Neon shared database (*.neon.tech). Set one of these to satisfy
# the isolation guard.
#
# Option A (recommended for CI): point at a dedicated Neon branch.
# Create a branch at console.neon.tech, copy its connection string here.
# E2E_DATABASE_URL=
#
# Option B: explicitly accept the shared-database risk.
# E2E_ALLOW_SHARED_DB=true
#
# IMPORTANT: Delete e2e/support/.auth/ after changing any SEED_*_EMAIL value.
# The 12h TTL cache in globalSetup skips re-acquisition for fresh files; a
# stale storageState carrying the old email's JWT will be reused silently.
# Fix: rm -rf e2e/support/.auth/

# --- Dev asset origins (dev only) ------------------------------------------
# Next blocks cross-origin requests for /_next/* in dev. Testing on a phone over
# your LAN without this set means the page renders and never hydrates — it looks
# like a broken app, not a blocked asset. Comma-separated list; use your
# machine's LAN IP.
# DEV_ALLOWED_ORIGINS=192.168.1.50:3000
